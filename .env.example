# Local preview uses persistent local storage by default. Never use real patient data here.
DEMO_MODE=true
DEMO_USE_DATABASE=false
# To use Atlas for preview, run npm run dev:atlas (uses the separate aerix_demo database).
DEMO_ALLOW_ATLAS_PREVIEW=false
PORT=4000
APP_ORIGIN=http://localhost:5173
# Atlas preview uses a separate database; never point it at the live database.
MONGODB_URI=
MONGODB_DB=aerix
MONGODB_DEMO_DB=aerix_demo
# Server-side only. Never prefix these values with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MONGODB_DNS_SERVER=
# Email delivery: configure with your chosen provider. No codes are logged.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Signup notifications, provider applications, and email emergency alerts go here.
AERIX_ADMIN_EMAIL=aerixcompany@gmail.com
EMAIL_WEB_URL=
EMAIL_WEB_TOKEN=
# Set a random secret of at least 32 characters; keep it server-side.
EMAIL_CODE_SECRET=
# Production requires NODE_ENV=production, DEMO_MODE=false, MongoDB and HTTPS APP_ORIGIN.
# HOST=0.0.0.0
# TRUST_PROXY=1  (only behind exactly one trusted reverse proxy)
